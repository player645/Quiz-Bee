# ---- Frontend (public values only; these end up in the browser bundle) ----
# URL of your deployed game server. Leave EMPTY for local development
# (the Vite dev server proxies /api to http://localhost:8787).
VITE_API_URL=
# "/" locally. For GitHub Pages project sites use "/<your-repo-name>/".
VITE_BASE=/

# ---- Game server (set these on your server host, never in the frontend) ----
PORT=8787
# Comma-separated list of allowed browser origins, e.g. https://yourname.github.io
# If empty, any origin is allowed (fine for local testing, not for production).
ALLOWED_ORIGINS=
# Set to 1 only if the server sits behind a trusted reverse proxy (Render, Fly, nginx).
TRUST_PROXY=0
