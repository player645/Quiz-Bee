{
  "name": "ph-social-science-quiz-bee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.ts",
    "dev:all": "concurrently -k -n web,api \"vite\" \"node --watch server/index.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate:questions": "node scripts/migrate-original.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  }
}
